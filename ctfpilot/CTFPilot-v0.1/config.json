{
  "llm": {
    "backends": [],
    "mock_fallback": true
  },
  "sandbox": {
    "offline": true,
    "blocked_command_patterns": [
      "curl ",
      "wget ",
      "nc ",
      "ncat ",
      "ssh ",
      "scp ",
      "ftp ",
      "Invoke-WebRequest",
      "Invoke-RestMethod",
      "http://",
      "https://",
      "powershell -c",
      "iwr "
    ],
    "allowed_executables": [
      "python"
    ],
    "shell_timeout_s": 60,
    "max_output_chars": 20000
  },
  "flagcheck": {
    "require_derived": true
  },
  "flag_patterns": [
    "flag:[^\\s{}]{4,128}:",
    "flag\\{(?!flag_not_here\\}|test_flag\\})[^\\s{}]{4,256}\\}",
    "FLAG\\{(?!flag_not_here\\}|test_flag\\})[^\\s{}]{4,256}\\}",
    "ctf\\{[^\\s{}]{4,256}\\}",
    "CTF\\{[^\\s{}]{4,256}\\}",
    "DASCTF\\{[^\\s{}]{4,256}\\}",
    "ctfshow\\{[^\\s{}]{4,256}\\}",
    "NSSCTF\\{[^\\s{}]{4,256}\\}",
    "SUCTF\\{[^\\s{}]{4,256}\\}",
    "hgame\\{[^\\s{}]{4,256}\\}"
  ],
  "budget": {
    "max_deep_steps": 12,
    "max_llm_calls_per_solve": 24,
    "fastpath_time_limit_s": 60
  },
  "memory": {
    "db_path": "memory/trajectories.sqlite",
    "recall_top_k": 3
  }
}